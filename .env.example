# pai-openai-wrapper configuration.
# Copy to .env and fill in. docker-compose reads this same file (including PORT).
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────
# Your PAI deployment (no trailing slash).
PAI_BASE_URL=https://pai-api.thepsi.com
# PAI API key (psai_ + 32 hex). Used outbound in single_key mode.
PAI_API_KEY=psai_replace_me

# ── Server ─────────────────────────────────────────────────────────────────
# Listen port. Single source of truth: uvicorn binds it, compose publishes it
# ("${PORT}:${PORT}"), and the healthcheck probes it. Change here only.
PORT=8000
LOG_LEVEL=info

# ── Models ─────────────────────────────────────────────────────────────────
# PAI's /api/models advertises every model the deployment knows about, NOT what your
# key may actually call — a non-entitled model returns 403 "Model not allowed".
# Restrict discovery to what really works so LiteLLM doesn't register broken models.
# Leave empty to publish everything PAI returns.
ALLOWED_MODELS=gemma4:26b,gemma4:cloud
# Used when a request omits "model".
#   gemma4:26b   -> local, fast (~3-10s)
#   gemma4:cloud -> proxies to gemma4:31b on ollama.com; ~35-40s AND leaves your network
DEFAULT_MODEL=gemma4:26b
# Prefix for published model ids. Keep this set: PAI exposes names like gpt-4.1-nano and
# claude-sonnet-4-6, which LiteLLM would otherwise price against its real OpenAI /
# Anthropic price maps. Both prefixed and bare ids are accepted inbound.
MODEL_NAME_PREFIX=pai/
MODELS_CACHE_TTL_S=300

# ── Auth ───────────────────────────────────────────────────────────────────
# single_key  : every upstream call uses PAI_API_KEY (recommended behind LiteLLM,
#               which already manages per-team virtual keys).
# passthrough : forward the caller's bearer as the PAI key (callers hold psai_ keys).
AUTH_MODE=single_key
# Optional inbound gate: comma-separated keys allowed to call /v1/*. Empty = open.
# Behind LiteLLM, set this to just LiteLLM's key.
WRAPPER_API_KEYS=

# ── Behaviour ──────────────────────────────────────────────────────────────
# PAI silently IGNORES the system role, so the caller's system prompt must ride along
# with the first user turn or it is lost. Change only if you want PAI's raw behaviour.
#   fold_into_first_user (default) | passthrough
SYSTEM_MESSAGE_POLICY=fold_into_first_user
# Expose PAI "thinking" as delta.reasoning_content (LiteLLM understands it; the vanilla
# OpenAI SDK ignores it harmlessly).
EMIT_REASONING=true
# Report dropped/unsupported params via x-pai-ignored-params / x-pai-unsupported.
SEND_UNSUPPORTED_HEADER=true
# Seconds between SSE keepalives when upstream goes quiet.
SSE_KEEPALIVE_S=15

# ── Limits & networking ────────────────────────────────────────────────────
MAX_REQUEST_MB=10
UPSTREAM_CONNECT_TIMEOUT_S=15
# Read timeout. Keep generous: gemma4:cloud can take 40s+.
REQUEST_TIMEOUT_S=600
# Comma-separated origins for browser callers. Empty = no CORS headers.
CORS_ALLOW_ORIGINS=
